# ==========================================
# MicroScraper Environment Configuration
# ==========================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=deep_search_results

# Used only by the Docker API container.
# Use host.docker.internal when PostgreSQL runs on your host machine.
# Keep empty/remove these variables to use the Docker db service instead.
API_POSTGRES_HOST=host.docker.internal
API_POSTGRES_PORT=5433

# Performance
# Number of maximum pages the engine can scrape simultaneously
MAX_CONCURRENT_SCRAPES=10
