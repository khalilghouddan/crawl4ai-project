# ==========================================
# MicroScraper Environment Configuration
# ==========================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=deep_search_results

# Used only by the Docker API container to reach your local PostgreSQL.
API_POSTGRES_HOST=host.docker.internal
API_POSTGRES_PORT=5433

# Performance
# Number of maximum pages the engine can scrape simultaneously.
# Crawl4AI uses browser contexts, so keep this modest on local machines.
MAX_CONCURRENT_SCRAPES=10

# Scrape timeouts
# The batch timeout should be lower than the HTTP client timeout used by agents.
SCRAPE_BATCH_TIMEOUT_SECONDS=240
SCRAPE_PAGE_TIMEOUT_MS=60000
SCRAPE_STATIC_FETCH_TIMEOUT_SECONDS=20

# Cache
# 0 means cached successful pages do not expire automatically.
# Set a value like 86400 for one day, or use request bypass_cache=true.
SCRAPE_CACHE_TTL_SECONDS=0
